# Supabase
SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_KEY=xxxxx
SUPABASE_ANON_KEY=xxxxx
SUPABASE_JWT_SECRET=xxxxx

# API Gateway
API_GATEWAY_PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# Microservices Ports
ACCOUNTING_SERVICE_PORT=3001
CRM_SERVICE_PORT=3002
INVENTORY_SERVICE_PORT=3003
CHATBOT_SERVICE_PORT=3004
VIDEO_SERVICE_PORT=3005
SCHEDULER_SERVICE_PORT=3006
HR_SERVICE_PORT=3007
SOCIAL_MEDIA_SERVICE_PORT=3008
WEBSOCKET_SERVICE_PORT=3009
ANALYTICS_SERVICE_PORT=3010
INTEGRATION_SERVICE_PORT=3011

# Frontend
NEXT_PUBLIC_API_BASE_URL=https://api.get-ly.com
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=xxxxx

# Domain
DOMAIN=get-ly.com

# Monitoring
SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# Redis (optional)
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=your-secret-key-here
